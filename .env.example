SESSION_SECRET=dev-change-me-to-a-long-random-string
# bcrypt 哈希里的 $ 请写成 \$，否则 Next 会展开坏掉
# 例: APP_PASSWORD_HASH=\$2a\$12\$........
APP_PASSWORD_HASH=

# 本地默认用文件库（会生成 ./data/emolog.db）
# TURSO_DATABASE_URL=file:./data/emolog.db
# 上线 Turso 时改成:
# TURSO_DATABASE_URL=libsql://xxxx.turso.io
# TURSO_AUTH_TOKEN=

# DeepSeek 或其它 OpenAI 兼容接口
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
